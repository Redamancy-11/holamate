# === HanoMate Data Pipeline Environment Variables ===

# MongoDB Connection URI (cùng DB với backend)
MONGO_URI=mongodb://localhost:27017/hanomate

# --- TikTok Scraper ---
# Từ khóa tìm kiếm, phân cách bằng dấu phẩy
TIKTOK_SEARCH_KEYWORDS=anuonghanoi,streetfoodhanoi,hanoifood,reviewhanoi,banhmihanoi
# Số lượng video tối đa mỗi keyword
TIKTOK_MAX_VIDEOS_PER_KEYWORD=30

# --- Facebook Scraper ---
# ID/slug các group cần cào, phân cách bằng dấu phẩy
FACEBOOK_GROUP_SLUGS=reviewanuonghanoi,hoiphuothanoi,hanoifoodguide
# Số bài viết tối đa mỗi group
FACEBOOK_MAX_POSTS_PER_GROUP=50
# Cookie (nếu có, để cào sâu hơn — không bắt buộc)
FACEBOOK_COOKIE=

# --- ShopeeFood Scraper ---
# City ID: Hà Nội = 217
SHOPEEFOOD_CITY_ID=217
# Số quán tối đa cần cào
SHOPEEFOOD_MAX_RESTAURANTS=100
# Category IDs: 1=Đồ ăn, 2=Đồ uống, 3=Bánh & Snack
SHOPEEFOOD_CATEGORY_IDS=1,2,3

# --- Pipeline chung ---
# Chế độ dry-run (chỉ log, không ghi DB)
DRY_RUN=false
# Mức log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
