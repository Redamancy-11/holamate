# Example environment variables for HanoMate

# MongoDB (optional, original project uses MongoDB for some features)
MONGODB_URI=mongodb://localhost:27017/hanomate

# Supabase / Postgres connection string
# Replace with your Supabase connection string.
# Example values:
#   Host: db.ffrucgiawjvzawhexnel.supabase.co
#   Port: 5432
#   Database: postgres
#   User: postgres
# Example:
# DATABASE_URL=postgresql://postgres:password@db.ffrucgiawjvzawhexnel.supabase.co:5432/postgres
# If your password contains special characters such as @, replace them with URL encoding.
# Example: Yeunhattrendoi2208@ -> Yeunhattrendoi2208%40
DATABASE_URL=

# Optional Supabase service key for helper features
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-key

# Gemini / Google Generative AI key (optional)
GEMINI_API_KEY=

# JWT secret for auth
JWT_SECRET=your_jwt_secret_here
